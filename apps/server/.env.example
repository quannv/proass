# Muse Model API key (https://dev.meta.ai). Server-side only.
MUSE_API_KEY=

# "muse" or "mock". Default: muse when MUSE_API_KEY is set, otherwise mock.
STT_PROVIDER=
LLM_PROVIDER=

# muse-wonder-1.0 (Standard only: prompts are not used for training). Alternative: muse-spark-1.3 (faster/cheaper).
MUSE_LLM_MODEL=muse-wonder-1.0
# ENDPOINTING or DIARIZATION (speaker labels)
MUSE_STT_MODE=DIARIZATION
# Muse models always reason: minimal | low | medium | high | xhigh
LLM_SUGGEST_REASONING_EFFORT=minimal
LLM_DEEP_REASONING_EFFORT=low

# Web searches per insight call (Muse built-in search, ~+6 s when used); 0 disables the web_search tool.
WEB_SEARCH_MAX=1

PORT=8787
# Comma-separated browser origins allowed to use this server (the web app URL).
ALLOWED_ORIGINS=http://localhost:3000
# Set in production so session tokens survive restarts / work across instances.
SESSION_SECRET=
# 1 behind a load balancer that appends the client IP to X-Forwarded-For (AWS ALB). Off locally.
# TRUST_PROXY=
# Abuse limits per client IP (MAX_CONCURRENT is the total). Defaults shown.
# MAX_SESSIONS_PER_IP_PER_HOUR=60
# MAX_CONCURRENT_PER_IP=5
# MAX_CONCURRENT=25
# MAX_EXPLAIN_PER_IP_PER_HOUR=120
# MAX_SUMMARY_PER_IP_PER_HOUR=20
# Optional JSON overrides for trigger thresholds, e.g. {"minWords":30,"minIntervalMs":12000}
TRIGGER_OVERRIDES=
